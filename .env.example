# SQLite file kept inside this site's folder
DATABASE_URL=file:./data/divepotato.db
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Folder for images uploaded in the admin panel. On the server, point it outside the app folder.
MEDIA_DIR=media
# Public URL of the site
NEXT_PUBLIC_SERVER_URL=http://localhost:3006
# Demo admin created by `npm run seed` (defaults shown)
SEED_ADMIN_EMAIL=admin@divepotato.local
SEED_ADMIN_PASSWORD=divepotato-demo
# Optional folder of .webp shop photos the seed copies into Media
SEED_PHOTOS_DIR=

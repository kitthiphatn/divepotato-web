# SQLite file kept inside this site's folder
DATABASE_URL=file:./data/divepotato.db
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Folder for images uploaded in the admin panel. On the server, point it outside the app folder.
MEDIA_DIR=media
# Public URL of the site
NEXT_PUBLIC_SERVER_URL=http://localhost:3006
# Demo admin created by `npm run seed` (defaults shown)
SEED_ADMIN_EMAIL=admin@divepotato.local
SEED_ADMIN_PASSWORD=divepotato-demo
# Optional folder of .webp shop photos the seed copies into Media
SEED_PHOTOS_DIR=
# Online payment keys. The provider (demo, Omise, Stripe or KBank) is chosen in the backoffice settings.
# Omise public key (pkey_test_… or pkey_…), used by Omise.js in the browser
OMISE_PUBLIC_KEY=
# Omise secret key (skey_test_… or skey_…), server only
OMISE_SECRET_KEY=
# Stripe publishable key (pk_test_… or pk_live_…), used by Stripe.js in the browser
STRIPE_PUBLISHABLE_KEY=
# Stripe secret key (sk_test_… or sk_live_…), server only
STRIPE_SECRET_KEY=
# KBank K Payment Gateway public key (pkey_test_… or pkey_prod_…), used by KBank's widget
KBANK_PUBLIC_KEY=
# KBank secret key (skey_test_… or skey_prod_…), server only
KBANK_SECRET_KEY=
# KBank merchant id (MID, 15 digits) for card payments; QR works without it
KBANK_MID=
# sandbox (dev-kpaymentgateway hosts, default) or production
KBANK_ENV=sandbox
